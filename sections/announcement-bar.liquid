{%- if section.settings.text != blank -%}
  <div class="announcement-bar">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="announcement-bar__message">
        {{ section.settings.text | escape }}
        <span aria-hidden="true">→</span>
      </a>
    {%- else -%}
      <p class="announcement-bar__message">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    padding: 10px 16px;
    background: var(--color-highlight);
    color: var(--color-highlight-contrast);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  .announcement-bar__message {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  a.announcement-bar__message:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Announcement bar",
    "enabled_on": {
      "groups": ["header"]
    },
    "settings": [
      {
        "type": "text",
        "id": "text",
        "label": "Message",
        "default": "Free shipping on orders over ₱1,500"
      }, {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "presets": [
      {
        "name": "Announcement bar"
      }
    ]
  }
{% endschema %}