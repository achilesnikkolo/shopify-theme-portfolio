<faq-accordion class="faq" data-single-open="{{ section.settings.single_open }}">
  {% if section.settings.heading != blank %}
    <h2 class="faq__heading">{{ section.settings.heading | escape }}</h2>
  {% endif %}

  {% if section.settings.description != blank %}
    <div class="faq__description">
      {{ section.settings.description }}
    </div>
  {% endif %}

  {% for block in section.blocks %}
    <details
      class="faq__item"
      {% if section.settings.open_first and forloop.first %}
      open{% endif %}
      {{ block.shopify_attributes }}>
      <summary class="faq__question">
        {{ block.settings.question | escape }}
      </summary>
      <div class="faq__answer">
        {{ block.settings.answer }}
      </div>
    </details>
  {% endfor %}
</faq-accordion>

{% stylesheet %}
  .faq {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 24px;
  }

  .faq__heading {
    margin-bottom: 16px;
  }

  .faq__description {
    margin-bottom: 24px;
  }

  .faq__item {
    margin-bottom: 12px;
    border: 1px solid #ccc;
    border-radius: 5px;
    padding: 16px;
  }

  .faq__answer {
    padding: 10px 0;
  }

  .faq__question {
    font-weight: bold;
    cursor: pointer;
  }


  @media (max-width: 749px) {
    .faq {
      padding: 40px 16px;
    }

    .faq__item {
      padding: 14px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FaqAccordion extends HTMLElement {
    connectedCallback() {

      if (this.dataset.singleOpen !== 'true') return;
      


      const items = this.querySelectorAll('details');

      items.forEach((item) => {
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          


          if (item.open) {
            items.forEach((other) => {
              if (other !== item) {
                other.open = false;
              }
            });
          }
        });
      });
    }
  }

  if (!customElements.get('faq-accordion')) {
    customElements.define('faq-accordion', FaqAccordion);
  }
{% endjavascript %}

{% schema %}
  {
    "name": "FAQ",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Frequently asked questions"
      }, {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Here are some of the most common questions we get from our customers.</p>"
      }, {
        "type": "checkbox",
        "id": "open_first",
        "label": "Open first question by default",
        "default": false
      }, {
        "type": "checkbox",
        "id": "single_open",
        "label": "Only one question open at a time",
        "default": false
      }
    ],
    "blocks": [
      {
        "type": "question",
        "name": "Question",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question",
            "default": "What is your return policy?"
          }, {
            "type": "richtext",
            "id": "answer",
            "label": "Answer",
            "default": "<p>We offer a 30-day return policy on all items.</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ",
        "blocks": [
          {
            "type": "question"
          }, {
            "type": "question"
          }
        ]
      }
    ]
  }
{% endschema %}