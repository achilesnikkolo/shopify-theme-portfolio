<div class="faq">
  <h2 class="faq__heading">
    {% if section.settings.heading != blank %}
      {{ section.settings.heading | escape }}
    {% endif %}
  </h2>

  {% if section.settings.description != blank %}
    <div class="faq__description">
      {{ section.settings.description }}
    </div>
  {% endif %}

  {% for block in section.blocks %}
    <details class="faq__item" {{ block.shopify_attributes }}>
      <summary class="faq__question">
        {{ block.settings.question }}
      </summary>
      <div class="faq__answer">
        {{ block.settings.answer }}
      </div>
    </details>
  {% endfor %}
</div>

{% stylesheet %}
  .faq {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }

  .faq__item {
    margin-bottom: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    padding: 10px;
  }

  .faq__question {
    font-weight: bold;
    cursor: pointer;
  }

  .faq__answer {
    margin-top: 10px;
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "FAQ",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Frequently asked questions"
      }, {
        "type": "richtext",
        "id": "description",
        "label": "Description",
        "default": "<p>Here are some of the most common questions we get from our customers.</p>"
      }
    ],
    "blocks": [
      {
        "type": "question",
        "name": "Question",
        "settings": [
          {
            "type": "text",
            "id": "question",
            "label": "Question",
            "default": "What is your return policy?"
          }, {
            "type": "richtext",
            "id": "answer",
            "label": "Answer",
            "default": "<p>We offer a 30-day return policy on all items.</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "FAQ",
        "blocks": [
          {
            "type": "question"
          }, {
            "type": "question"
          }
        ]
      }
    ]
  }
{% endschema %}