<section class="hero hero--{{ section.settings.text_alignment }}" style="--hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '100vw', loading: 'eager', class: 'hero__image', alt: section.settings.image.alt
      }}
    {% else %}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__image hero__placeholder' }}
    {% endif %}
  </div>

  <div class="hero__content">
    {% if section.settings.heading != blank %}
      <h2 class="hero__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="hero__text">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="hero__button">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    min-height: 70vh;
    overflow: hidden;
    color: #ffffff;
  }

  .hero__media,
  .hero__content {
    grid-area: 1 / 1;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    background: #5f5e5a;
    fill: #888780;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: var(--hero-overlay, 0.4);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    max-width: 640px;
    padding: 48px 24px;
  }

  .hero--center .hero__content {
    align-items: center;
    margin: 0 auto;
    text-align: center;
  }

  .hero--left .hero__content {
    align-items: flex-start;
    margin-left: clamp(24px, 6vw, 96px);
  }

  .hero__heading {
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
  }

  .hero__button {
    display: inline-block;
    padding: 12px 24px;
    border-radius: 999px;
    background: #ffffff;
    color: #1f1f1d;
    font-weight: 600;
    text-decoration: none;
  }

  .hero__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Hero banner",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Brewed in the Philippines"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>Small-batch coffee from Batangas to Benguet.</p>"
      },
      {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Shop now"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button link"
      }, {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Overlay darkness",
        "min": 0,
        "max": 80,
        "step": 10,
        "unit": "%",
        "default": 40
      }, {
        "type": "select",
        "id": "text_alignment",
        "label": "Text alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "center",
            "label": "Center"
          }
        ],
        "default": "center"
      }
    ],
    "presets": [
      {
        "name": "Hero banner"
      }
    ]
  }
{% endschema %}