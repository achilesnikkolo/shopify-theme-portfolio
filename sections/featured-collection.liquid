{% liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
%}

<section class="featured-collection" style="--columns-desktop: {{ section.settings.columns_desktop }};">
  <div class="featured-collection__header">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.show_view_all and collection != blank %}
      <a href="{{ collection.url }}" class="featured-collection__view-all">
        View all
      </a>
    {% endif %}
  </div>

  <ul class="featured-collection__grid" role="list">
    {% if collection != blank %}
      {% for product in collection.products limit: limit %}
        <li>{% render 'product-card'
, product: product %}</li>
      {% else %}
        <li class="featured-collection__empty">This collection doesn't have any products yet.</li>
      {% endfor %}
    {% else %}
      {% for i in (1..limit) %}
        <li>
          <article class="product-card">
            <div class="product-card__media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
            </div>
            <h3 class="product-card__title">Product title</h3>
            <p class="product-card__price">{{ 1999 | money }}</p>
          </article>
        </li>
      {% endfor %}
    {% endif %}
  </ul>
</section>

{% stylesheet %}
  .featured-collection {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .featured-collection__heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .featured-collection__view-all {
    color: var(--color-accent);
    font-weight: 600;
  }

  .featured-collection__view-all:hover {
    color: var(--color-accent-hover);
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .featured-collection__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    .featured-collection__grid {
      grid-template-columns: repeat(var(--columns-desktop, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Featured collection",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Our coffees"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "range",
        "id": "products_to_show",
        "label": "Products to show",
        "min": 2,
        "max": 12,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "columns_desktop",
        "label": "Columns on desktop",
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 4
      }, {
        "type": "checkbox",
        "id": "show_view_all",
        "label": "Show \"View all\" link",
        "default": true
      }
    ],
    "presets": [
      {
        "name": "Featured collection"
      }
    ]
  }
{% endschema %}

{{ 'product-card.css' | asset_url | stylesheet_tag }}