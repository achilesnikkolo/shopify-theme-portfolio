{% liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
%}

<section class="featured-collection" style="--columns-desktop: {{ section.settings.columns_desktop }};">
  <div class="featured-collection__header">
    {% if section.settings.heading != blank %}
      <h2 class="featured-collection__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.show_view_all and collection != blank %}
      <a href="{{ collection.url }}" class="featured-collection__view-all">
        View all
      </a>
    {% endif %}
  </div>

  <ul class="featured-collection__grid" role="list">
    {% if collection != blank %}
      {% for product in collection.products limit: limit %}
        <li>{% render 'product-card'
, product: product %}</li>
      {% else %}
        <li class="featured-collection__empty">This collection doesn't have any products yet.</li>
      {% endfor %}
    {% else %}
      {% for i in (1..limit) %}
        <li>
          <article class="product-card">
            <div class="product-card__media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}
            </div>
            <h3 class="product-card__title">Product title</h3>
            <p class="product-card__price">{{ 1999 | money }}</p>
          </article>
        </li>
      {% endfor %}
    {% endif %}
  </ul>
</section>

{% stylesheet %}
  .featured-collection {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 24px;
  }

  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .featured-collection__heading {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .featured-collection__view-all {
    color: inherit;
    font-weight: 600;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 750px) {
    .featured-collection__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 990px) {
    .featured-collection__grid {
      grid-template-columns: repeat(var(--columns-desktop, 4), minmax(0, 1fr));
    }
  }

  .product-card__link {
    color: inherit;
    text-decoration: none;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: 12px;
    background: #f1efe8;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card__link:hover .product-card__image {
    transform: scale(1.04);
  }

  .product-card__placeholder {
    fill: #b4b2a9;
  }

  .product-card__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #0f6e56;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .product-card__badge--sold-out {
    background: #5f5e5a;
  }

  .product-card__title {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 500;
  }

  .product-card__price {
    margin: 0;
    font-weight: 600;
  }

  .product-card__compare-price {
    margin-left: 6px;
    color: #5f5e5a;
    font-weight: 400;
  }

  .product-card__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Featured collection",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Our coffees"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "range",
        "id": "products_to_show",
        "label": "Products to show",
        "min": 2,
        "max": 12,
        "step": 1,
        "default": 4
      },
      {
        "type": "range",
        "id": "columns_desktop",
        "label": "Columns on desktop",
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 4
      }, {
        "type": "checkbox",
        "id": "show_view_all",
        "label": "Show \"View all\" link",
        "default": true
      }
    ],
    "presets": [
      {
        "name": "Featured collection"
      }
    ]
  }
{% endschema %}