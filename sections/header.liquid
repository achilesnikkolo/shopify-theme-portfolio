{{ 'header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
<header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" style="--logo-width: {{ section.settings.logo_width }}px;">
  <div class="site-header__inner">
    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 500 | image_tag: widths: '160, 250, 500', sizes: '250px', loading: 'eager', class: 'site-header__logo-image', alt: shop.name
        }}
      {%- else -%}
        <span class="site-header__wordmark">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a
              href="{{ link.url }}"
              class="site-nav__link"
              {% if link.current %}
              aria-current="page"
              {% endif %}>{{ link.title | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__icons">
        <button
        type="button"
        class="site-header__icon"
        popovertarget="Search-{{ section.id }}"
        aria-label="Search"
        >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-4-4"></path>
        </svg>
        </button>       
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="site-header__icon"
          aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="site-header__icon site-header__cart"
        aria-label="Cart ({{ cart.item_count }} items)"
        data-cart-link>
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span
          class="site-header__count"
          data-cart-count
          {% if cart.item_count == 0 %}
          hidden{% endif %}>
          {{- cart.item_count -}}
        </span>
      </a>

      <button
        type="button"
        class="site-header__icon site-header__menu-toggle"
        popovertarget="MobileMenu-{{ section.id }}"
        aria-label="Open menu">
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <nav
    id="MobileMenu-{{ section.id }}"
    class="mobile-menu"
    popover
    aria-label="Mobile">
    <div class="mobile-menu__header">
      <span class="site-header__wordmark">{{ shop.name | escape }}</span>
      <button
        type="button"
        class="site-header__icon"
        popovertarget="MobileMenu-{{ section.id }}"
        popovertargetaction="hide"
        aria-label="Close menu">
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <ul class="mobile-menu__list" role="list">
      {%- for link in section.settings.menu.links -%}
        <li>
          <a
            href="{{ link.url }}"
            class="mobile-menu__link"
            {% if link.current %}
            aria-current="page"
            {% endif %}>{{ link.title | escape }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>
  <div id="Search-{{ section.id }}" class="search-panel" popover>
    <predictive-search
      class="search-panel__inner"
      data-search-url="{{ routes.predictive_search_url }}"
    >
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-panel__form">
        <label for="SearchInput-{{ section.id }}" class="visually-hidden">Search Akipelago</label>
        <input
          id="SearchInput-{{ section.id }}"
          class="search-panel__input"
          type="search"
          name="q"
          placeholder="Search coffees…"
          autocomplete="off"
          autofocus
        >
        <button
          type="button"
          class="site-header__icon"
          popovertarget="Search-{{ section.id }}"
          popovertargetaction="hide"
          aria-label="Close search"
        >
          <span aria-hidden="true">×</span>
        </button>
      </form>

      <div class="search-panel__results" data-predictive-results></div>
    </predictive-search>
  </div>
</header>

{% schema %}
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      }, {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 250,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      }, {
        "type": "link_list",
        "id": "menu",
        "label": "Menu",
        "default": "main-menu"
      }, {
        "type": "checkbox",
        "id": "sticky",
        "label": "Sticky header",
        "default": true
      }
    ]
  }
{% endschema %}