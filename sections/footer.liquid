{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer class="site-footer">
  <div class="site-footer__top">
    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}" class="site-footer__wordmark">{{ shop.name | escape }}</a>

      {%- if section.settings.tagline != blank -%}
        <p class="site-footer__tagline">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="site-footer__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- if section.settings.social_instagram != blank or section.settings.social_tiktok != blank or section.settings.social_facebook != blank
      -%}
        <ul class="site-footer__social" role="list">
          {%- if section.settings.social_instagram != blank -%}
            <li>
              <a href="{{ section.settings.social_instagram }}">Instagram</a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <li>
              <a href="{{ section.settings.social_tiktok }}">TikTok</a>
            </li>
          {%- endif -%}
          {%- if section.settings.social_facebook != blank -%}
            <li>
              <a href="{{ section.settings.social_facebook }}">Facebook</a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div class="site-footer__column" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if block.settings.menu.links.size > 0 -%}
          <ul class="site-footer__links" role="list">
            {%- for link in block.settings.menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}

    {%- if section.settings.show_newsletter -%}
      <div class="site-footer__newsletter">
        <h2 class="site-footer__heading">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- if section.settings.newsletter_text != blank -%}
          <p class="site-footer__description">{{ section.settings.newsletter_text | escape }}</p>
        {%- endif -%}

        {%- form 'customer'
          , id: 'FooterNewsletter'
          , class: 'newsletter-form' -%}
          <input
            type="hidden"
            name="contact[tags]"
            value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="newsletter-form__success" role="status">Salamat! You're on the list. 🎉</p>
          {%- else -%}
            <div class="newsletter-form__field">
              <label for="FooterNewsletterEmail" class="visually-hidden">Email address</label>
              <input
                id="FooterNewsletterEmail"
                class="newsletter-form__input"
                type="email"
                name="contact[email]"
                placeholder="Your email"
                autocomplete="email"
                required
                {% if form.errors %}
                aria-invalid="true"
                aria-describedby="FooterNewsletterError"
                {% endif %}>
              <button type="submit" class="newsletter-form__button">Subscribe</button>
            </div>

            {%- if form.errors -%}
              <div id="FooterNewsletterError" class="newsletter-form__error">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  <div class="site-footer__bottom">
    <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>

    {%- if section.settings.menu.links.size > 0 -%}
      <ul class="site-footer__policies" role="list">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul
        class="site-footer__payments"
        role="list"
        aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "text",
        "id": "tagline",
        "label": "Tagline",
        "default": "Coffee from across the islands."
      },
      {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Small-batch Filipino coffee, from bold Batangas barako to bright Benguet Arabica."
      },
      {
        "type": "header",
        "content": "Social links"
      }, {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      }, {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      }, {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      }, {
        "type": "header",
        "content": "Newsletter"
      }, {
        "type": "checkbox",
        "id": "show_newsletter",
        "label": "Show newsletter signup",
        "default": true
      }, {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Heading",
        "default": "Join the Akipelago club"
      }, {
        "type": "textarea",
        "id": "newsletter_text",
        "label": "Text",
        "default": "New roasts, merienda pairings, and member-only treats, straight to your inbox."
      }, {
        "type": "header",
        "content": "Bottom bar"
      }, {
        "type": "link_list",
        "id": "menu",
        "label": "Policy links menu"
      }, {
        "type": "checkbox",
        "id": "show_payment_icons",
        "label": "Show payment icons",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "link_column",
        "name": "Link column",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Shop"
          }, {
            "type": "link_list",
            "id": "menu",
            "label": "Menu"
          }
        ]
      }
    ],
    "max_blocks": 3
  }
{% endschema %}